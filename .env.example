# ==============================================================================
# PRAPTI Environment Configuration Template
# Copy this file to .env.local and populate the values below:
#   cp .env.example .env.local
# ==============================================================================

# Supabase Public Configuration (Required for client and SSR auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Server-Only Secret (Required for administrative actions & demo seeder)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Google Gemini API Key (Required for Prapti AI Assistant and RAG explanations)
GEMINI_API_KEY=AIzaSy...

# AI Model Execution Mode: "judging" (default: recommended for evaluation) | "testing" (lite fallback)
GEMINI_MODEL_MODE=judging

# Site URL (Optional, defaults to http://localhost:3000 in development)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
